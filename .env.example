# CodeForge Academy — copy to .env and adjust. Never commit a real .env.
PORT=8080
HOST=127.0.0.1
DATABASE_PATH=./data/codeforge.db
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
SESSION_TTL_HOURS=24
REMEMBER_ME_TTL_DAYS=30
RUN_TIMEOUT_MS=10000
MAX_RUN_OUTPUT_BYTES=262144
# Optional: extra directories searched for language runtimes (colon-separated)
RUNTIME_EXTRA_PATHS=/home/deepak/.cargo/bin
# Set to 1 to allow the platform to run on 0.0.0.0 (LAN). Default binds localhost.
# BIND_LAN=0
